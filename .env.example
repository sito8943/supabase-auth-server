PORT=3090
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080
SUPABASE_BRIDGE_KEY=replace-with-shared-secret-between-java-and-node

# Required
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase replaced the anon JWT with a publishable key. The legacy
# SUPABASE_ANON_KEY name is still read as a fallback.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional for future admin endpoints. No route uses it today.
# Legacy SUPABASE_SERVICE_ROLE_KEY is still read as a fallback.
SUPABASE_SECRET_KEY=sb_secret_...
